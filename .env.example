# Copie para .env e preencha. NUNCA commite o .env.

# GitHub (token pessoal, só leitura de repos públicos, para não bater em rate limit)
GITHUB_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
# ID do grupo privado (com Tópicos ativados). Só ele é aceito.
TELEGRAM_CHAT_ID=
# ID do seu usuário. Só ele pode clicar nos botões e usar comandos.
TELEGRAM_USER_ID=
# message_thread_id de cada tópico
TELEGRAM_TOPICO_DEV=
TELEGRAM_TOPICO_SUPORTE=

# Caminho do banco SQLite
DB_PATH=./data/radar.db

# Fuso e horário do resumo diário (cron)
TZ=America/Recife
CRON_RESUMO=0 8 * * *
CRON_COLETA=0 */3 * * *
