{
  "name": "radar-vagas",
  "version": "0.1.0",
  "description": "Agregador pessoal de vagas open-source: fontes abertas, score por perfil e resumo diário no Telegram.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Rafael Melo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasfaeel11/radar-vagas.git"
  },
  "bugs": {
    "url": "https://github.com/rasfaeel11/radar-vagas/issues"
  },
  "homepage": "https://github.com/rasfaeel11/radar-vagas#readme",
  "keywords": [
    "vagas",
    "telegram-bot",
    "job-aggregator",
    "typescript"
  ],
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
